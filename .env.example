EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Opcional: refina textos del plan con IA (si no está, usa motor local)
# EXPO_PUBLIC_OPENAI_API_KEY=

# Development build con Salud/HealthKit (NO usar en Expo Go):
# EXPO_PUBLIC_ENABLE_NATIVE_HEALTH=true

# Anthropic (solo en Supabase Dashboard → Edge Functions, NO en el cliente):
# ANTHROPIC_API_KEY=sk-ant-...

# For migrations (one of these — never commit real values):
# SUPABASE_DB_PASSWORD=          # Project Settings → Database
# SUPABASE_ACCESS_TOKEN=         # https://supabase.com/dashboard/account/tokens
