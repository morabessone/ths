{
  "expo": {
    "name": "LivIn",
    "slug": "livin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "livin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.livin.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "LivIn lee pasos, sueño y entrenamientos de Apple Salud para ajustar tu plan nutricional.",
        "NSHealthUpdateUsageDescription": "LivIn puede registrar datos de salud que autorices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "package": "app.livin.mobile",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "LivIn lee pasos, sueño y entrenamientos para personalizar tu plan.",
          "NSHealthUpdateUsageDescription": "LivIn puede guardar datos de salud que autorices."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LivIn necesita la cámara para escanear códigos de barras de alimentos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
